---
/**
 * RoleBadge — who a thing is for.
 *
 * The interesting value is `both`, and it is the reason this is one component
 * rather than two. A skill read by both roles is not a third colour: it is
 * literally the two marks side by side, which is a *structural* difference, not
 * a palette one. The temptation is to copy the file and hand-build that case;
 * the cost arrives later, when the badge changes shape and only one of them
 * follows. So it is a declared variant, and the mark is built from the same
 * bands whatever the role turns out to be.
 */
interface Props {
  role: 'designer' | 'developer' | 'both'
  class?: string
}

const { role, class: extra } = Astro.props

const base = 'inline-flex items-center gap-2 rounded-xs border px-2 py-1 text-xs font-medium tracking-wide uppercase'

const byRole = {
  designer: {
    label: 'designer',
    chip: 'border-designer/40 bg-designer-surface text-designer',
    bands: ['bg-designer'],
  },
  developer: {
    label: 'developer',
    chip: 'border-developer/40 bg-developer-surface text-developer',
    bands: ['bg-developer'],
  },
  both: {
    label: 'both',
    chip: 'border-foreground/30 bg-card text-foreground font-semibold',
    bands: ['bg-designer', 'bg-developer'],
  },
}

const { label, chip, bands } = byRole[role]
---

<span class:list={[base, chip, extra]}>
  <span class="flex h-3 w-4 overflow-hidden rounded-xs" aria-hidden="true">
    {bands.map((band) => <span class:list={['flex-1', band]} />)}
  </span>
  {label}
</span>
