---
/**
 * StepNumber — where you are in a sequence.
 *
 * Zero-padded because `01` and `02` line up down a column and `1` and `2` do
 * not, and a procedure is read as a column.
 *
 * It used to carry an `of` prop as well, printing `01 / 32`. The count moved
 * onto the rows themselves, at which point the total repeated thirty-two times
 * was noise rather than orientation, and the prop was left demonstrated by its
 * own specimen and used by nothing. So it is gone.
 */
interface Props {
  /** 1-based position in the sequence. */
  index: number
  class?: string
}

const { index, class: extra } = Astro.props

const base = 'font-mono text-xs font-semibold tracking-wide text-primary'
---

<span class:list={[base, extra]}>{String(index).padStart(2, '0')}</span>
