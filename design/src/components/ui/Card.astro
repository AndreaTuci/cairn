---
/**
 * Card - a surface with a title and a body.
 *
 * Note what it does *not* do: it has no "featured" mode with its own padding,
 * no variant that changes the heading level, no special case for the homepage.
 * Special cases aren't special enough to break the rules; when one turns out to
 * be genuine, it arrives as a declared variant — as `elevation` did, because a
 * page made of paper has nothing on it that floats.
 */
import { cx, variants } from '../../lib/cx'

interface Props {
  title?: string
  elevation?: 'raised' | 'flat'
  class?: string
}

const { title, elevation = 'raised', class: extra } = Astro.props

const VARIANTS = {
  elevation: {
    raised: 'shadow-card bg-card',
    flat: 'bg-transparent',
  },
} as const
---

<article
  class={cx(
    'rounded-lg border text-card-foreground p-6',
    variants(VARIANTS, { elevation }, { elevation: 'raised' }),
    extra,
  )}
>
  {title && <h3 class="text-lg font-semibold">{title}</h3>}
  <div class={title ? 'mt-2' : ''}>
    <slot />
  </div>
</article>
