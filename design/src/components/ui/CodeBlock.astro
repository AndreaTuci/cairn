---
/**
 * CodeBlock — commands and tool output, shown verbatim.
 *
 * The content arrives as a prop rather than a slot on purpose: whitespace in a
 * code sample is meaning, and a slot picks up the indentation of whatever markup
 * happens to surround it.
 *
 * `wrap` exists because two different things end up in here. Tool output is a
 * fixed-width report — wrapping it would break the columns it is made of, so it
 * scrolls. A single long line of code is just a long line, and wrapping it is
 * what an editor does anyway. Printing wraps both, because paper does not
 * scroll; that rule lives in the theme.
 */
interface Props {
  code: string
  /** What the reader is looking at, when that is not obvious from the code. */
  label?: string
  wrap?: 'none' | 'soft'
  class?: string
}

const { code, label, wrap = 'none', class: extra } = Astro.props

const base = 'overflow-hidden rounded-md border bg-card'
const body = 'p-4 font-mono text-xs text-foreground'

const byWrap = {
  none: 'overflow-x-auto',
  soft: 'whitespace-pre-wrap',
}
---

<figure class:list={[base, extra]}>
  {
    label && (
      <figcaption class="border-b bg-muted px-4 py-2 font-mono text-xs text-muted-foreground">
        {label}
      </figcaption>
    )
  }
  <pre class:list={[body, byWrap[wrap]]}><code>{code}</code></pre>
</figure>
