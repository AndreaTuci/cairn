---
/**
 * Text — body copy, in the three weights this project actually has.
 *
 * It exists so that twenty paragraphs across two pages do not each carry their
 * own class string. The moment they do, changing the reading size means finding
 * all twenty; here it means changing one line.
 */
interface Props {
  variant?: 'lead' | 'body' | 'note'
  as?: 'p' | 'div'
  class?: string
}

const { variant = 'body', as = 'p', class: extra } = Astro.props

const byVariant = {
  lead: 'text-lg text-foreground',
  body: 'text-base text-foreground',
  note: 'text-sm text-muted-foreground',
}

const Tag = as
---

<Tag class:list={[byVariant[variant], extra]}><slot /></Tag>
