---
/**
 * PartsGallery — every component of this guide that can be put in a case, in one.
 *
 * It is a catalogue rather than a piece of the page it sits on: it grows by one
 * entry every time the project grows by one component, and it is the thing to
 * open before asking for a new one. Kept out of the page so that the page stays
 * an argument and this stays a list.
 *
 * Six components are missing on purpose. `SiteHeader`, `PageIntro`, `Section`,
 * `SiteFooter`, `Specimen` and `PartsGallery` *are* the page around this — the
 * last two are the case itself, and the reader is already looking at a dozen of
 * them. Drawing any of the six in a box here would be the duplication the whole
 * guide is against, so the page points at them instead.
 */
import Specimen from './Specimen.astro'
import Figure from './Figure.astro'
import DefinitionRow from './DefinitionRow.astro'
import LabelledList from './LabelledList.astro'
import RoleBadge from './RoleBadge.astro'
import RichText from './RichText.astro'
import Text from './ui/Text.astro'
import Code from './ui/Code.astro'
import CodeBlock from './ui/CodeBlock.astro'
import Card from './ui/Card.astro'
import Blaze from './ui/Blaze.astro'
import StepNumber from './ui/StepNumber.astro'
import StepList from './StepList.astro'
import { auditRules } from '../fixtures/audit-rules'
import { metrics } from '../fixtures/metrics'
import { stepGroups } from '../fixtures/steps'
import { cx } from '../lib/cx'

/**
 * The samples come from the fixtures rather than being written here, so they
 * cannot drift from the real thing — and because a `RichText` example with no
 * backticked term in it would be demonstrating nothing at all.
 */
const sample = auditRules.find((rule) => rule.id === 'arbitrary-scale') ?? auditRules[0]
const counted = metrics[0]
const sentenceWithTerms = metrics.find((metric) => metric.label.includes('`--')) ?? metrics[0]

const NOT_YOUR_JOB = ['What a component is called.', 'Where a file goes.', 'Git.']

/** A real group of the procedure, at its real number — so the sample cannot drift either. */
const procedure = stepGroups.find((group) => group.readBy === 'designer') ?? stepGroups[0]

interface Props {
  class?: string
}

const { class: extra } = Astro.props
---

  <div class={cx('grid gap-4 sm:grid-cols-2', extra)}>
    <Specimen name="Text" note="Body copy. Three levels of voice, and nobody re-types them.">
      <Text variant="lead">An opening line</Text>
      <Text>The text you are reading now.</Text>
      <Text variant="note">A note in the margin.</Text>
    </Specimen>

    <Specimen name="Code" note="A technical term inside a sentence: a command, a file, a class.">
      <Text>Open <Code>design/</Code> and type <Code>/design-workflow</Code>.</Text>
    </Specimen>

    <Specimen name="Blaze" note="This project’s mark. Two sizes, and the colour of whoever is reading.">
      <div class="flex items-end gap-4">
        <Blaze />
        <Blaze size="sm" />
        <Blaze tone="designer" />
        <Blaze tone="developer" />
      </div>
    </Specimen>

    <Specimen name="Figure" note="A measured number, and what was counted. Taken from the Guide page, not re-typed.">
      <Figure value={counted.value} label={counted.label} />
    </Specimen>

    <Specimen name="RoleBadge" note="Who a thing is for. The third case is two marks, not a third colour.">
      <div class="flex flex-wrap gap-2">
        <RoleBadge role="designer" />
        <RoleBadge role="developer" />
        <RoleBadge role="both" />
      </div>
    </Specimen>

    <Specimen name="Card" note="A surface. Raised, or flat as paper.">
      <Card><Text variant="note">Raised: white, with a shadow under it.</Text></Card>
      <Card elevation="flat"><Text variant="note">Flat: nothing floats on paper.</Text></Card>
    </Specimen>

    <Specimen name="CodeBlock" note="Commands and output, exact down to the space.">
      <CodeBlock label="a command" code="npm run design:check" />
    </Specimen>

    <Specimen name="StepNumber" note="Where you are in a sequence. Zero-padded because `01` and `02` line up down a column and `1` and `2` do not.">
      <div class="flex items-center gap-6">
        <StepNumber index={1} />
        <StepNumber index={9} />
        <StepNumber index={12} />
      </div>
    </Specimen>

    <Specimen
      name="StepList"
      class="sm:col-span-2"
      note="Numbered steps, counted across a whole page instead of restarting at every group. Two rows of `/getting-started`, at their real numbers."
    >
      <StepList steps={procedure.steps.slice(0, 2)} start={procedure.start} />
    </Specimen>

    <Specimen name="RichText" note="Sentences arriving from the data, with their technical terms already set.">
      <Text><RichText copy={sentenceWithTerms.label} /></Text>
    </Specimen>

    <Specimen
      name="DefinitionRow"
      class="sm:col-span-2"
      note="A term and what it means. One row, for two lists with nothing else in common."
    >
      <dl class="border-t border-rule">
        <DefinitionRow term={sample.id}><RichText copy={sample.catches} /></DefinitionRow>
      </dl>
    </Specimen>

    <Specimen
      name="LabelledList"
      class="sm:col-span-2"
      note="A short heading over plain statements. Only legible next to its opposite."
    >
      <LabelledList title="what you do not need to know" items={NOT_YOUR_JOB} tone="designer" />
    </Specimen>
  </div>
