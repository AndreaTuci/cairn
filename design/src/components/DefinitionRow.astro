---
/**
 * DefinitionRow — a term and what it means, as a row in a list.
 *
 * The same shape serves the five skills and the ten audit rules, which is the
 * whole argument for it existing: two lists that look alike are one component
 * with different data, not two components that drift apart the first time
 * somebody adjusts the spacing on one of them.
 */
interface Props {
  term: string
  /** `strong` is for the row that carries more weight than its neighbours. */
  emphasis?: 'default' | 'strong'
  class?: string
}

const { term, emphasis = 'default', class: extra } = Astro.props
const hasAside = Astro.slots.has('aside')

const base = 'grid gap-x-8 gap-y-2 border-b px-3 py-4 sm:grid-cols-3'

const byEmphasis = {
  default: 'border-rule',
  strong: 'border-foreground/25 bg-muted',
}
---

<div class:list={[base, byEmphasis[emphasis], extra]}>
  <dt class="font-mono text-sm font-medium break-words text-foreground">{term}</dt>
  <dd class="sm:col-span-2">
    {hasAside && <div class="mb-2"><slot name="aside" /></div>}
    <span class="text-base text-foreground"><slot /></span>
  </dd>
</div>
