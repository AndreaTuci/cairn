---
/**
 * SiteFooter — the next mark on the trail.
 *
 * A guide read end to end needs one thing at the bottom: where to go next.
 * Anything more is furniture.
 *
 * The whole row is the link, eyebrow included. It used to be a caption sitting
 * beside a link, which meant the one word naming the thing was the one word you
 * could not click — and a word that looks like a control and is not is worse
 * than no word.
 */
import Blaze from './ui/Blaze.astro'
import { nextPage } from '../lib/navigation'

const next = nextPage(Astro.url.pathname)
---

<footer class="border-t border-rule">
  <a
    href={next.href}
    class="group mx-auto flex max-w-3xl items-center justify-between gap-6 rounded-xs px-6 py-8"
  >
    <span
      class="font-mono text-xs tracking-wide uppercase text-muted-foreground transition-colors group-hover:text-primary"
    >
      Next
    </span>
    <span
      class="flex items-center gap-3 font-display text-lg font-semibold text-foreground transition-colors group-hover:text-primary"
    >
      <Blaze size="sm" />
      {next.label}
    </span>
  </a>
</footer>
