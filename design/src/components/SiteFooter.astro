---
/**
 * SiteFooter — the next mark on the trail.
 *
 * A two-page guide read end to end needs one thing at the bottom: the other
 * page. Anything more is furniture.
 */
import Blaze from './ui/Blaze.astro'
import { otherPage } from '../lib/navigation'

const next = otherPage(Astro.url.pathname)
---

<footer class="border-t border-rule">
  <div class="mx-auto flex max-w-3xl items-center justify-between gap-6 px-6 py-8">
    <p class="font-mono text-xs tracking-wide uppercase text-muted-foreground">Continua</p>
    <a
      href={next.href}
      aria-label={`Continua: ${next.label}`}
      class="flex items-center gap-3 rounded-xs font-display text-lg font-semibold text-foreground hover:text-primary"
    >
      <Blaze size="sm" />
      {next.label}
    </a>
  </div>
</footer>
