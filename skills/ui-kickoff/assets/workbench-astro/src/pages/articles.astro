---
/**
 * A screen, and what "finished" means for one.
 *
 * A screen is not done when the happy path looks right. It is done when it
 * answers for all of its states - because a state the design never drew is a
 * state a developer will invent alone, at the end of a sprint, badly.
 *
 * Switch `state` to review each one.
 */
import Page from '../layouts/Page.astro'
import Card from '../components/ui/Card.astro'
import { articles, noArticles, type Article } from '../fixtures/articles'

type ScreenState = 'ready' | 'empty' | 'loading' | 'error'

const state: ScreenState = 'ready'
const items: Article[] = state === 'empty' ? noArticles : articles
---

<Page title="Articles">
  <main class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-xl font-semibold">Articles</h1>

    {state === 'loading' && (
      <div class="mt-8 space-y-4" aria-busy="true" aria-label="Loading articles">
        <div class="h-28 animate-pulse rounded-lg bg-muted"></div>
        <div class="h-28 animate-pulse rounded-lg bg-muted"></div>
      </div>
    )}

    {state === 'error' && (
      <Card class="mt-8 border-destructive">
        <h2 class="font-semibold text-destructive">These articles could not be loaded</h2>
        <p class="mt-1 text-sm text-muted-foreground">
          Reload the page. If it keeps happening, the list is temporarily unavailable.
        </p>
      </Card>
    )}

    {state !== 'loading' && state !== 'error' && items.length === 0 && (
      <Card class="mt-8">
        <h2 class="font-semibold">No articles yet</h2>
        <p class="mt-1 text-sm text-muted-foreground">The first one you publish appears here.</p>
      </Card>
    )}

    {state !== 'loading' && state !== 'error' && items.length > 0 && (
      <ul class="mt-8 space-y-4">
        {items.map((article) => (
          <li>
            <Card title={article.title}>
              <p class="text-sm text-muted-foreground">{article.excerpt}</p>
              <p class="mt-3 text-xs text-muted-foreground">{article.publishedAt}</p>
            </Card>
          </li>
        ))}
      </ul>
    )}
  </main>
</Page>
