<!-- ui-audit-allow: unused-component — seeded primitive. It ships with the workbench and
     is in use from the first real screen; the demo page that used it is deleted on day one. -->
---
/**
 * Card - a surface with a title and a body.
 *
 * Note what it does *not* do: it has no "featured" mode with its own padding,
 * no variant that changes the heading level, no special case for the homepage.
 * Special cases aren't special enough to break the rules; when one turns out to
 * be genuine, it arrives as a declared variant.
 */
import { cx } from '../../lib/cx'

interface Props {
  title?: string
  class?: string
}

const { title, class: extra } = Astro.props
---

<article class={cx('rounded-lg border bg-card text-card-foreground p-6 shadow-card', extra)}>
  {title && <h3 class="text-lg font-semibold">{title}</h3>}
  <div class={title ? 'mt-2' : ''}>
    <slot />
  </div>
</article>
